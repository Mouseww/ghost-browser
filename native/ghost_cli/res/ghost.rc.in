// Resources embedded into ghost.exe.
//
// The point of this file is that a downloaded ghost.exe is the entire product:
// the injectable shim and the default profile live inside the executable, so
// there is nothing else to fetch or keep in step.
//
// Only the shim is embedded. The self-test target is ghost.exe's own hidden
// `__probe` subcommand, so no second executable is ever written to disk — see
// the note in CMakeLists.txt.
//
// The path is substituted by CMake and is absolute, because rc.exe resolves
// relative paths against its own working directory rather than the source tree.

#include <windows.h>

// 101 = ghost_shim.dll. Keep in sync with embed.h.
101 RCDATA "@GHOST_SHIM_DLL_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @GHOST_VERSION_COMMA@
PRODUCTVERSION @GHOST_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "unknowbrowser contributors\0"
            VALUE "FileDescription", "Ghost browser launcher\0"
            VALUE "FileVersion", "@GHOST_VERSION@\0"
            VALUE "InternalName", "ghost\0"
            VALUE "LegalCopyright", "BSD-3-Clause\0"
            VALUE "OriginalFilename", "ghost.exe\0"
            VALUE "ProductName", "ghost-browser\0"
            VALUE "ProductVersion", "@GHOST_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
