#include <windows.h>

// The shim carries the project icon so it can put it on the browser window it
// brands, without depending on where ghost.exe was installed. Resource id 1,
// matching the launcher, so the same id means the same icon everywhere.
1 ICON "@GHOST_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @GHOST_VERSION_COMMA@
PRODUCTVERSION @GHOST_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "unknowbrowser contributors\0"
            VALUE "FileDescription", "Ghost Browser native shim\0"
            VALUE "FileVersion", "@GHOST_VERSION@\0"
            VALUE "InternalName", "ghost_shim\0"
            VALUE "LegalCopyright", "BSD-3-Clause\0"
            VALUE "OriginalFilename", "ghost_shim.dll\0"
            VALUE "ProductName", "Ghost Browser\0"
            VALUE "ProductVersion", "@GHOST_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
