# Normalize line endings so the Windows-only native code and the
# cross-platform Python tooling don't fight over CRLF.
* text=auto eol=lf

# Windows-only build files and shell scripts keep CRLF.
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.filters  text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Never touch binaries.
*.dll   binary
*.exe   binary
*.pdb   binary
*.lib   binary
*.obj   binary
*.png   binary
*.ico   binary
