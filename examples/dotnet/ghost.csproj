<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free C# client for the ghost control protocol.
    Nothing but the BCL: System.IO (named pipe) and System.Text.Json (envelope).
    No PackageReference anywhere on purpose.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ghost</AssemblyName>
    <RootNamespace>Ghost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
